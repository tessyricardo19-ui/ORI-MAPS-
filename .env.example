# Copiez ce fichier en ".env" et remplissez les valeurs.
# Le fichier ".env" est ignoré par Git (voir .gitignore) : ne l'envoyez jamais sur GitHub.

# --- Supabase ---
SUPABASE_URL=
# Clé "anon" : publique par conception, protégée par le RLS dans Supabase
SUPABASE_ANON_KEY=
# Clé "service_role" : SECRÈTE. Uniquement côté serveur, jamais dans une page web
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend (Node.js / Express) ---
JWT_SECRET=
DATABASE_URL=
# Chemin vers la clé privée RSA (fichier hors du dépôt)
RSA_PRIVATE_KEY_PATH=
